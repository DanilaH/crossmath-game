  "definitions": {
    "D4": "normalized occupied numeric-cell coordinate pattern modulo four rotations and reflections; ignores operators, values and mask, does not equate actual puzzles",
    "D4ShapeMask": "same geometry canonicalization with hidden/given bit; still ignores values/operators",
    "peelResidual": "remaining hidden cells after iterated simultaneous singleton-equation removal, purely structural; not Guru stuck, not solve time",
    "shapeGap": "distance to last occurrence of same D4 class within the modeled track, not calendar dates",
    "repeatId": "distance to previous exact puzzleId within stream, not similarity or an observed session"
  }
